# Clerk publishable key for client authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key

# Email Configuration (Nodemailer Gmail SMTP)
# Note: Use a Gmail App Password, NOT your main account password.
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# API Configuration
VITE_API_BASE_URL=http://localhost:5000

# CORS Allowed Origin for Express Backend (for production, set to your frontend domain)
# ALLOWED_ORIGIN=https://yourdomain.com

# MongoDB Atlas URI (required for invoice feature)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/swamyslabs?retryWrites=true&w=majority

# JWT secret — use a long random string (min 32 chars) in production
JWT_SECRET=replace_with_a_very_long_random_secret_string

# Admin portal password — single shared password for the invoice admin
ADMIN_PASSWORD=your_secure_admin_password_here
